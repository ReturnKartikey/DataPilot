# OpenRouter powers V4 natural-language intent routing and report narratives.
# Create a key at https://openrouter.ai/keys. Keep this key on the backend only.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Data Pilot
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_MODE=chat_completions
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=35
# json_object is broadly compatible; use json_schema only with a model that supports it.
LLM_RESPONSE_FORMAT=json_object

# Optional research / experiment tracking
DATAPILOT_ENABLE_LIVE_RESEARCH=true
DATAPILOT_ENABLE_MLFLOW=false
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=DataPilot
DATAPILOT_ENABLE_SHAP=true

# API hardening
DATAPILOT_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATAPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATAPILOT_MAX_UPLOAD_MB=25
DATAPILOT_MAX_ROWS=250000
DATAPILOT_MAX_COLUMNS=250
DATAPILOT_MAX_CELLS=5000000
# Optional bearer/X-API-Key token for mutating & LLM-triggering endpoints (recommended outside localhost)
DATAPILOT_API_TOKEN=
# Per-IP rate limit per minute for expensive analysis/regeneration endpoints (0 disables)
DATAPILOT_RATE_LIMIT_PER_MIN=30
# Optional HMAC key for signing saved joblib model artifacts (auto-generated in artifacts/ if unset)
DATAPILOT_ARTIFACT_SIGNING_KEY=

# V3 orchestration, data engine and optional model extensions
DATAPILOT_DATA_ENGINE=auto
DATAPILOT_DUCKDB_THRESHOLD_MB=100
DATAPILOT_ENABLE_DEEP_LEARNING=false
DATAPILOT_MLP_EPOCHS=80
DATAPILOT_RESEARCH_DB=research_knowledge.sqlite3
DATAPILOT_ENABLE_RESEARCH_EMBEDDINGS=false
DATAPILOT_RESEARCH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Short timeout for intent routing; deterministic inference is used if unavailable.
LLM_INTENT_TIMEOUT_SECONDS=12
